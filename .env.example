# Free key from https://www.themoviedb.org/settings/api (v3 API key or v4 read access token)
TMDB_API_KEY=
# Free key from https://aistudio.google.com/apikey (optional — on-device OCR is used without it)
GEMINI_API_KEY=
# GEMINI_MODEL=  (optional override; defaults to the newest available Flash model)
REGION=US
API_PORT=3001
